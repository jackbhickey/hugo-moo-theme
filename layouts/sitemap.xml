{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- /* When auth is enabled, only list public pages — a non-public (auth-gated)
         page must not be enumerated here, or the sitemap would advertise the very
         URLs the proxy is hiding. With no auth configured, `public` is ignored and
         all pages are listed. Same flag the nav trim uses. */ -}}
  {{ $authEnabled := ne (site.Params.authCheckUrl | default "") "" }}
  {{ range .Data.Pages }}
    {{ if and .Permalink (or (not $authEnabled) (default true .Params.public)) (ne .Layout "nav-fragment") }}
    <url>
      <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
      <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
      <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
      <priority>{{ .Sitemap.Priority }}</priority>{{ end }}
    </url>
    {{ end }}
  {{ end }}
</urlset>
